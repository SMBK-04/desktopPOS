@model EnterprisePOS.Models.ViewModels.ProductEditViewModel
@{
    ViewBag.Title = "Edit Product";
}

<div class="page-header">
    <div>
        <div class="page-title"><i class="bi bi-pencil-fill me-2" style="color:var(--accent);"></i>Edit Product</div>
        <div class="page-subtitle">Update product information</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn-pos btn-ghost"><i class="bi bi-arrow-left me-1"></i>Back</a>
        <button type="button" class="btn-pos btn-danger-pos" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash3-fill me-1"></i> Delete
        </button>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImagePath" />

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="pos-card mb-4">
                <h6 style="font-weight:600;margin-bottom:20px;color:var(--text-secondary);text-transform:uppercase;font-size:12px;">Basic Information</h6>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label-pos">Product Name *</label>
                        <input asp-for="Name" class="form-control-pos" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-4"><label class="form-label-pos">Product Code</label><input asp-for="ProductCode" class="form-control-pos" /></div>
                    <div class="col-md-4"><label class="form-label-pos">Barcode</label><input asp-for="Barcode" class="form-control-pos" /></div>
                    <div class="col-md-4"><label class="form-label-pos">SKU</label><input asp-for="SKU" class="form-control-pos" /></div>
                    <div class="col-12"><label class="form-label-pos">Description</label><textarea asp-for="Description" class="form-control-pos" rows="3"></textarea></div>
                </div>
            </div>

            <div class="pos-card mb-4">
                <h6 style="font-weight:600;margin-bottom:20px;color:var(--text-secondary);text-transform:uppercase;font-size:12px;">Pricing & Tax</h6>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label-pos">Cost Price</label><input asp-for="CostPrice" class="form-control-pos" type="number" step="0.01" /></div>
                    <div class="col-md-6"><label class="form-label-pos">Selling Price</label><input asp-for="SellingPrice" class="form-control-pos" type="number" step="0.01" /></div>
                </div>
            </div>

            <div class="pos-card">
                <h6 style="font-weight:600;margin-bottom:20px;color:var(--text-secondary);text-transform:uppercase;font-size:12px;">Settings</h6>
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-label-pos mb-0">Active</label>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="pos-card mb-4">
                <h6 style="font-weight:600;margin-bottom:20px;color:var(--text-secondary);text-transform:uppercase;font-size:12px;">Classification</h6>
                <div class="mb-3">
                    <label class="form-label-pos">Category</label>
                    <select asp-for="CategoryId" class="form-control-pos" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))"></select>
                </div>
                <div>
                    <label class="form-label-pos">Product Type</label>
                    <select asp-for="ProductType" class="form-control-pos">
                        <option value="0">Standard</option>
                        <option value="1">Combo</option>
                        <option value="2">Service</option>
                    </select>
                </div>
            </div>

            <div class="pos-card mb-4">
                <h6 style="font-weight:600;margin-bottom:20px;color:var(--text-secondary);text-transform:uppercase;font-size:12px;">Product Image</h6>
                <div id="imagePreview" style="width:100%;height:160px;background:var(--bg-hover);border-radius:10px;overflow:hidden;margin-bottom:12px;border:2px dashed var(--border);display:flex;align-items:center;justify-content:center;">
                    @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                    {
                        <img src="@Model.ExistingImagePath" style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {
                        <div style="text-align:center;color:var(--text-muted);">
                            <i class="bi bi-image" style="font-size:32px;display:block;margin-bottom:8px;"></i>
                            <div style="font-size:12px;">No image</div>
                        </div>
                    }
                </div>
                <input type="file" name="ImageFile" accept="image/*" class="form-control-pos" onchange="previewImage(this)" />
                <div style="font-size:11px;color:var(--text-muted);margin-top:6px;">Leave empty to keep existing image</div>
            </div>

            <button type="submit" class="btn-pos btn-primary-pos w-100" style="justify-content:center;padding:14px;font-size:15px;">
                <i class="bi bi-check-circle-fill me-2"></i>Save Changes
            </button>
        </div>
    </div>
</form>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);">
            <div class="modal-body text-center" style="padding:28px;">
                <i class="bi bi-trash3-fill" style="font-size:40px;color:var(--danger);display:block;margin-bottom:12px;"></i>
                <div style="font-size:16px;font-weight:600;margin-bottom:8px;">Delete Product?</div>
                <div style="font-size:14px;color:var(--text-muted);margin-bottom:20px;">@Model.Name</div>
                <div class="d-flex gap-8 justify-content-center">
                    <button type="button" class="btn-pos btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <form action="/Products/HardDelete/@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-pos btn-danger-pos">Permanently Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function previewImage(input) {
    if (input.files?.[0]) {
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('imagePreview').innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;border-radius:10px;" />`;
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
