<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title — Enterprise Solutions</title>
    <meta name="description" content="Enterprise Solutions System — Modern, Fast, Reliable" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- POS Theme -->
    <link rel="stylesheet" href="~/css/pos-theme.css" asp-append-version="true" />

    <style>
        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 0, 0, 0.65);
            backdrop-filter: blur(3px);
            -webkit-backdrop-filter: blur(3px);
            z-index: 1040;
            opacity: 0;
            transition: opacity 0.25s ease;
        }
        .sidebar-backdrop.show {
            display: block;
            opacity: 1;
        }

        @@media (max-width: 991px) {
            html, body {
                overflow-x: hidden !important;
                width: 100% !important;
                max-width: 100vw !important;
            }
            .app-wrapper {
                overflow-x: hidden !important;
                width: 100% !important;
                max-width: 100vw !important;
                position: relative;
            }
            .sidebar {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                bottom: 0 !important;
                height: 100vh !important;
                width: 280px !important;
                max-width: 85vw !important;
                z-index: 1050 !important;
                transform: translateX(-100%) !important;
                transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
                box-shadow: 4px 0 24px rgba(0, 0, 0, 0.5) !important;
            }
            .sidebar.mobile-open {
                transform: translateX(0) !important;
            }
            .main-content {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100vw !important;
                min-width: 0 !important;
                overflow-x: hidden !important;
            }
            .main-content.expanded {
                margin-left: 0 !important;
            }
            .top-header {
                padding: 0 14px !important;
                height: 56px !important;
            }
            .header-title {
                font-size: 16px !important;
                font-weight: 700 !important;
            }
            .page-content {
                padding: 14px 12px !important;
                width: 100% !important;
                max-width: 100vw !important;
                overflow-x: hidden !important;
            }
            .alert.alert-danger {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 12px !important;
            }
            .kpi-grid {
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 12px !important;
                margin-bottom: 20px !important;
            }
            .kpi-card {
                padding: 14px 12px !important;
                gap: 10px !important;
            }
            .kpi-icon {
                width: 38px !important;
                height: 38px !important;
                font-size: 16px !important;
                border-radius: 8px !important;
            }
            .kpi-label {
                font-size: 11px !important;
            }
            .kpi-value {
                font-size: 17px !important;
            }
        }

        @@media (max-width: 576px) {
            .kpi-grid {
                grid-template-columns: 1fr !important;
                gap: 10px !important;
            }
            .kpi-card {
                padding: 12px 14px !important;
            }
            .chart-container {
                height: 220px !important;
            }
            div[style*="overflow-x:auto"] {
                width: 100% !important;
                max-width: 100% !important;
                overflow-x: auto !important;
                -webkit-overflow-scrolling: touch !important;
            }
        }
    </style>

    <script>
        // Apply saved theme BEFORE render to avoid flash
        (function() {
            var t = localStorage.getItem('pos-theme') || 'dark';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
</head>
<body>
<div class="app-wrapper">

    <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-brand d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-icon"><i class="bi bi-shop"></i></div>
                <div class="sidebar-brand-text">
                    <div class="brand-text">Enterprise Solutions</div>
                    <div class="brand-sub">v1.0 — Admin Panel</div>
                </div>
            </div>
            <button type="button" class="btn-pos btn-ghost d-lg-none" id="sidebarCloseBtn" style="padding:4px 8px;font-size:18px;color:var(--text-muted);" title="Close Menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="sidebar-nav">
            <!-- MAIN -->
            <div class="nav-section-label">Main</div>

            <a href="/Dashboard" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            @if (!User.IsInRole("SuperAdmin"))
            {
                <a href="/POS" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "POS" ? "active" : "")">
                    <i class="bi bi-cash-stack"></i>
                    <span>Point of Sale</span>
                </a>

                <!-- MANAGEMENT -->
                <div class="nav-section-label" style="margin-top:8px">Management</div>

                <a href="/Categories" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                    <i class="bi bi-folder-fill"></i>
                    <span>Categories</span>
                </a>
                <a href="/Products" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")">
                    <i class="bi bi-box-seam-fill"></i>
                    <span>Products</span>
                </a>
                <a href="/Sales" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span>Sales History</span>
                </a>
                @if (User.IsInRole("Administrator") || User.IsInRole("Manager"))
                {
                    <a href="/Deals" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Deals" ? "active" : "")">
                        <i class="bi bi-tag-fill"></i>
                        <span>Manage Deals</span>
                    </a>
                }
                <!-- REPORTS -->
                <div class="nav-section-label" style="margin-top:8px">Reports</div>

                <a href="/Reports" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Reports</span>
                </a>

                <!-- ADMIN -->
                @if (User.IsInRole("Administrator"))
                {
                    <div class="nav-section-label" style="margin-top:8px">Administration</div>
                    <a href="/Account/Users" class="nav-item">
                        <i class="bi bi-people-fill"></i>
                        <span>Users & Roles</span>
                    </a>
                }
            }

            @if (User.IsInRole("SuperAdmin"))
            {
                <div class="nav-section-label" style="margin-top:8px">SuperAdmin</div>
                <a href="/SuperAdmin" class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SuperAdmin" ? "active" : "")">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Manage Tenants</span>
                </a>
            }
        </div>

        <!-- Sidebar Footer -->
        <div style="padding:16px; border-top: 1px solid var(--border);">
            <div style="font-size:11px; color:var(--text-muted); text-align:center;">
                Enterprise Solutions &copy; @DateTime.Now.Year
            </div>
        </div>
    </nav>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <!-- END SIDEBAR -->

    <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
    <div class="main-content" id="mainContent">

        <!-- Top Header -->
        <header class="top-header">
            <button class="header-toggle" id="sidebarToggle" title="Toggle Menu" style="display:flex;align-items:center;justify-content:center;">
                <i class="bi bi-list fs-4"></i>
            </button>

            <div class="header-title">@ViewBag.Title</div>

            <div class="header-actions">
                <!-- Theme Toggle -->
                <button class="theme-toggle" id="themeToggle" title="Toggle Dark/Light Mode">
                    <i class="bi bi-sun-fill" id="themeIcon"></i>
                </button>



                <!-- User Menu -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-menu dropdown">
                        <div class="user-avatar" data-bs-toggle="dropdown" style="cursor:pointer">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end" style="background:var(--bg-card);border:1px solid var(--border);">
                            <li><span class="dropdown-item-text" style="color:var(--text-secondary);font-size:13px;">@User.Identity.Name</span></li>
                            <li><hr class="dropdown-divider" style="border-color:var(--border);" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item" style="color:var(--danger);">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </header>

        <!-- Page Body -->
        <div class="page-content">
            @if (ViewBag.IsSubscriptionExpired == true || Context.Items["IsSubscriptionExpired"] as bool? == true)
            {
                <div class="alert alert-danger d-flex align-items-center justify-content-between mb-4 shadow-sm" style="background: linear-gradient(135deg, rgba(220,38,38,0.18), rgba(15,23,42,0.7)); border: 1.5px solid #ef4444; border-radius: var(--radius); color: #fca5a5;">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-exclamation-triangle-fill fs-3 text-danger"></i>
                        <div>
                            <div class="fw-bold text-white">Subscription Expired — Please Pay Your Outstanding Bills</div>
                            <div class="small" style="color: #cbd5e1;">Your restaurant subscription has expired. Please clear your outstanding invoice immediately to avoid service interruption. You may continue using the system for now.</div>
                        </div>
                    </div>
                    @if (!User.IsInRole("SuperAdmin"))
                    {
                        <a href="/POS" class="btn-pos btn-accent" style="white-space:nowrap; padding: 6px 14px; font-size: 13px;">
                            <i class="bi bi-cash-stack me-1"></i> Open POS
                        </a>
                    }
                </div>

                <!-- Opening Modal for Admin / Manager -->
                <div class="modal fade" id="layoutBillsModal" tabindex="-1" data-bs-backdrop="static">
                    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
                        <div class="modal-content" style="background:var(--bg-card);border:2px solid #ef4444;border-radius:var(--radius);box-shadow: 0 10px 30px rgba(239,68,68,0.35);">
                            <div class="modal-body text-center p-4">
                                <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
                                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 40px;"></i>
                                </div>
                                <h4 class="fw-bold text-danger mb-2" style="letter-spacing: -0.3px;">Please Pay Your Outstanding Bills</h4>
                                <p class="text-white fw-semibold mb-2" style="font-size: 14.5px;">
                                    Your restaurant subscription has expired.
                                </p>
                                <p style="color:var(--text-muted);font-size:13px;line-height:1.6;" class="mb-4">
                                    Please pay your outstanding bills immediately to avoid interruption to your services. 
                                    You can continue using the dashboard and POS for now.
                                </p>
                                <button type="button" class="btn-pos btn-accent w-100 py-2 fw-bold" onclick="dismissLayoutBillsModal()">
                                    <i class="bi bi-check2-circle me-1"></i> I Understand &amp; Continue
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div id="tempSuccess" data-message="@TempData["Success"]" data-type="success"></div>
            }
            @if (TempData["Error"] != null)
            {
                <div id="tempError" data-message="@TempData["Error"]" data-type="error"></div>
            }

            @RenderBody()
        </div>
    </div>
    <!-- END MAIN CONTENT -->
</div>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<!-- SignalR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    // ─── Toast System ────────────────────────────────────────────
    function showToast(message, type = 'success') {
        const icons = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' };
        const colors = { success: 'var(--success)', error: 'var(--danger)', warning: 'var(--warning)', info: 'var(--info)' };
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = 'pos-toast';
        toast.innerHTML = `<i class="bi ${icons[type] || icons.info}" style="color:${colors[type]};font-size:18px;flex-shrink:0;"></i><span style="font-size:14px;flex:1;">${message}</span><i class="bi bi-x" style="cursor:pointer;color:var(--text-muted);" onclick="this.parentElement.remove()"></i>`;
        container.appendChild(toast);
        setTimeout(() => { if (toast.parentElement) toast.remove(); }, 4000);
    }

    // ─── Theme Toggle ────────────────────────────────────────────
    (function() {
        var theme = localStorage.getItem('pos-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
        updateThemeIcon(theme);

        document.getElementById('themeToggle').addEventListener('click', function() {
            var current = document.documentElement.getAttribute('data-theme');
            var next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('pos-theme', next);
            updateThemeIcon(next);
        });

        function updateThemeIcon(t) {
            var icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
            }
        }
    })();

    // ─── Sidebar Toggle (Mobile Drawer & Desktop Collapse) ────────
    function toggleSidebar() {
        var isMobile = window.innerWidth <= 991;
        var sidebar = document.getElementById('sidebar');
        var main = document.getElementById('mainContent');
        var backdrop = document.getElementById('sidebarBackdrop');

        if (isMobile) {
            var isOpen = sidebar.classList.contains('mobile-open');
            if (isOpen) {
                sidebar.classList.remove('mobile-open');
                if (backdrop) backdrop.classList.remove('show');
                document.body.style.removeProperty('overflow');
            } else {
                sidebar.classList.add('mobile-open');
                if (backdrop) backdrop.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
        } else {
            sidebar.classList.toggle('collapsed');
            main.classList.toggle('expanded');
        }
    }

    function closeMobileSidebar() {
        var sidebar = document.getElementById('sidebar');
        var backdrop = document.getElementById('sidebarBackdrop');
        if (sidebar) sidebar.classList.remove('mobile-open');
        if (backdrop) backdrop.classList.remove('show');
        document.body.style.removeProperty('overflow');
    }

    var sidebarToggle = document.getElementById('sidebarToggle');
    if (sidebarToggle) sidebarToggle.addEventListener('click', toggleSidebar);

    var sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
    if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeMobileSidebar);

    var sidebarBackdrop = document.getElementById('sidebarBackdrop');
    if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', closeMobileSidebar);

    document.querySelectorAll('.sidebar-nav .nav-item').forEach(function(item) {
        item.addEventListener('click', function() {
            if (window.innerWidth <= 991) {
                closeMobileSidebar();
            }
        });
    });

    window.addEventListener('resize', function() {
        if (window.innerWidth > 991) {
            closeMobileSidebar();
        }
    });

    // ─── Show TempData Toasts ────────────────────────────────────
    window.addEventListener('DOMContentLoaded', function() {
        var s = document.getElementById('tempSuccess');
        var e = document.getElementById('tempError');
        if (s) showToast(s.dataset.message, 'success');
        if (e) showToast(e.dataset.message, 'error');
    });



    @if (ViewBag.IsSubscriptionExpired == true || Context.Items["IsSubscriptionExpired"] as bool? == true)
    {
        <text>
        function dismissLayoutBillsModal() {
            sessionStorage.setItem('layoutBillsModalSeen', 'true');
            sessionStorage.setItem('billsModalAcknowledged', 'true');
            var layoutModalElem = document.getElementById('layoutBillsModal');
            if (layoutModalElem) {
                var m = bootstrap.Modal.getInstance(layoutModalElem);
                if (m) m.hide();
            }
            setTimeout(function() {
                document.querySelectorAll('.modal-backdrop').forEach(function(b) { b.remove(); });
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
            }, 100);
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (!sessionStorage.getItem('layoutBillsModalSeen')) {
                var layoutModalElem = document.getElementById('layoutBillsModal');
                if (layoutModalElem) {
                    var layoutModal = new bootstrap.Modal(layoutModalElem);
                    layoutModal.show();
                }
            }
        });
        </text>
    }
</script>

@RenderSection("Scripts", required: false)
@if (TempData["DownloadReportUrl"] != null)
{
    <script>
        window.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                window.location.href = '@TempData["DownloadReportUrl"]';
            }, 1000);
        });
    </script>
}
</body>
</html>
