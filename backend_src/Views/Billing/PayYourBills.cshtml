@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subscription Blocked - Enterprise POS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #0f172a;
            color: #f1f5f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 40px;
            max-width: 500px;
            text-align: center;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
        .warning-icon {
            font-size: 64px;
            color: #ef4444;
            margin-bottom: 20px;
        }
        h1 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 16px;
        }
        p {
            color: #94a3b8;
            margin-bottom: 28px;
            line-height: 1.6;
        }
        .btn-logout {
            background-color: #6366f1;
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }
        .btn-logout:hover {
            background-color: #4f46e5;
            color: white;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="warning-icon">🚫</div>
        <h1>Account Blocked</h1>
        <p>Your restaurant account has been blocked by the system administrator. Please contact your system provider or support team to resolve outstanding matters and restore access.</p>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn-logout">Sign Out</button>
        </form>
    </div>
</body>
</html>
