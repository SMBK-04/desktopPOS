@model EnterprisePOS.Models.Entities.Sale
@using Microsoft.EntityFrameworkCore
@inject EnterprisePOS.Data.ApplicationDbContext Db
@{
    Layout = null;
    var tenant = Db.Tenants.IgnoreQueryFilters().FirstOrDefault(t => t.Id == Model.TenantId);
    string tenantName = tenant?.Name ?? "Breadline";
    string tenantBranch = tenant?.BranchName ?? "North Karachi";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <style>
        @@page {
            size: 80mm auto;
            margin: 0mm;
        }
        @@media print {
            html, body {
                width: 72mm !important;
                margin: 0 !important;
                padding: 1mm 0 2mm 0 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 10.5px;
            color: #000;
            background: #fff;
            width: 72mm;
            margin: 0;
            padding: 2mm 0;
        }
        .center { text-align: center; }
        .right  { text-align: right; }
        .shop-name { font-size: 15px; font-weight: bold; text-align: center; margin-bottom: 2px; }
        .shop-addr { font-size: 9px; text-align: center; line-height: 1.5; margin-bottom: 4px; }
        .hr-solid  { border: none; border-top: 1px solid #000; margin: 3px 0; }
        .hr-dotted { border: none; border-top: 1px dashed #000; margin: 3px 0; }
        table.info { width: 100%; }
        table.info td { font-size: 9px; padding: 0.5px 0; }
        table.info td.v { text-align: right; }
        table.info td.l { text-align: left; }
        table.items { width: 100%; border-collapse: collapse; }
        table.items thead th { font-size: 9px; font-weight: bold; border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 2px 0; }
        table.items thead th.l { text-align: left; }
        table.items thead th.r { text-align: right; }
        table.items tbody td { font-size: 9px; padding: 0.5px 0; vertical-align: top; }
        table.items tbody td.r { text-align: right; }
        .item-title { font-weight: bold; padding-top: 3px; }
        table.totals { width: 100%; }
        table.totals td { font-size: 9px; font-weight: bold; padding: 1px 0; }
        table.totals td.r { text-align: right; }
        .footer-msg { font-size: 9.5px; font-weight: bold; text-align: center; margin-top: 5px; line-height: 1.6; }
        .powered { font-size: 8px; text-align: center; margin-top: 2px; }

        /* Strictly hide Somee host watermark and advertising links */
        a[href*="somee"], div[style*="text-align:center"], div[style*="somee"], center, footer {
            display: none !important;
            visibility: hidden !important;
            height: 0 !important;
            font-size: 0 !important;
            opacity: 0 !important;
            line-height: 0 !important;
        }
    </style>
</head>
<body id="receiptBody">

    <div class="shop-name">@tenantName</div>
    <div class="shop-addr">
        @if (tenantName.ToLower() == "breadline")
        {
            @:House R-461 Babul Islam Town Sector 9<br />
            @:North<br />
            @:Karachi Pakistan<br />
            @:Tel No : 0371-1226804
        }
        else
        {
            @tenantBranch
        }
    </div>

    <hr class="hr-solid" />

    <table class="info">
        <tr><td>Date:</td><td class="v">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
        <tr><td>Sale No/Ref:</td><td class="v">@Model.InvoiceNumber</td></tr>
        <tr><td>Sales Associate:</td><td class="v">@(Model.Cashier?.FullName ?? "Administrator")</td></tr>
        <tr><td>Customer:</td><td class="v">@(Model.Customer?.Name ?? "Walk-in Customer")</td></tr>
        <tr><td>Type:</td><td class="v">@Model.OrderType</td></tr>
        @if (!string.IsNullOrEmpty(Model.TableNumber))
        {
            <tr><td>Table:</td><td class="v">@Model.TableNumber</td></tr>
        }
    </table>

    <table class="items">
        <thead>
            <tr>
                <th class="l" style="width:42%">Name</th>
                <th class="r" style="width:20%">Price</th>
                <th class="r" style="width:12%">Qty</th>
                <th class="r" style="width:26%">Amount</th>
            </tr>
        </thead>
        <tbody>
            @{ int idx = 1; }
            @foreach (var item in Model.SaleItems)
            {
                <tr>
                    <td class="l item-title" style="padding-top: 3px; vertical-align: top;">
                        #@idx @item.ProductName@(!string.IsNullOrEmpty(item.Modifiers) ? $" ({item.Modifiers})" : "")
                    </td>
                    <td class="r" style="padding-top: 3px; vertical-align: top;">@item.UnitPrice.ToString("F2")</td>
                    <td class="r" style="padding-top: 3px; vertical-align: top;">@item.Quantity.ToString("F2")</td>
                    <td class="r" style="padding-top: 3px; vertical-align: top;">@item.LineTotal.ToString("F2")</td>
                </tr>
                idx++;
            }
        </tbody>
    </table>

    <hr class="hr-dotted" />

    <table class="totals">
        <tr><td>Total</td><td class="r">@Model.TotalAmount.ToString("F2")</td></tr>
        <tr><td>Grand total</td><td class="r">@Model.TotalAmount.ToString("F2")</td></tr>
    </table>
    <hr class="hr-solid" />
    <table class="totals">
        <tr><td>Paid Amount</td><td class="r">@Model.AmountPaid.ToString("F2")</td></tr>
    </table>
    <hr class="hr-solid" />
    <table class="info">
        <tr>
            <td style="font-size:9px;">Paid by: @Model.PaymentMethod.ToString().ToLower()</td>
            <td class="v" style="font-size:9px;">Change: @Model.ChangeGiven.ToString("F2")</td>
        </tr>
    </table>

    <div class="footer-msg">Thank you for shopping with us. Please<br />come again</div>
    <div class="powered">Powered by Enterprise POS <strong>03161036764</strong></div>

</body>
</html>
