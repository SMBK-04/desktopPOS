@model EnterprisePOS.Models.ViewModels.SuperAdminDashboardViewModel
@{
    ViewBag.Title = "SuperAdmin Dashboard";
    var monthlyLabelsJson = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels);
    var monthlyCountsJson = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyNewTenantCounts);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0" style="color: var(--text-primary); font-weight:700;">
            <i class="bi bi-speedometer2 me-2" style="color:var(--accent);"></i>SaaS Platform Dashboard
        </h1>
        <p class="text-muted mb-0">Overview of registered client businesses, monthly tenant growth, and subscription lifecycles.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/SuperAdmin" class="btn-pos btn-ghost" style="padding:10px 18px;font-size:13px;">
            <i class="bi bi-shield-lock-fill me-1"></i> Manage Tenants
        </a>
        <a href="/SuperAdmin/CreateTenant" class="btn-pos btn-primary-pos" style="padding:10px 18px;font-size:13px;">
            <i class="bi bi-plus-lg me-1"></i> New Tenant
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="kpi-grid mb-4">
    <div class="kpi-card">
        <div class="kpi-icon revenue" style="background:#6366f120;color:#6366f1;"><i class="bi bi-building"></i></div>
        <div>
            <div class="kpi-label">Total Tenants</div>
            <div class="kpi-value">@Model.TotalTenants</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon profit" style="background:#10b98120;color:#10b981;"><i class="bi bi-check-circle-fill"></i></div>
        <div>
            <div class="kpi-label">Active Subscriptions</div>
            <div class="kpi-value">@Model.ActiveTenants</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon orders" style="background:#3b82f620;color:#3b82f6;"><i class="bi bi-graph-up-arrow"></i></div>
        <div>
            <div class="kpi-label">New This Month</div>
            <div class="kpi-value">+@Model.NewTenantsThisMonth</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon expense" style="background:#ef444420;color:#ef4444;"><i class="bi bi-shield-x"></i></div>
        <div>
            <div class="kpi-label">Blocked / Expired</div>
            <div class="kpi-value">@(Model.BlockedTenants + Model.ExpiredTenants)</div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <!-- Monthly Onboarding Chart -->
    <div class="col-lg-8">
        <div class="pos-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <div style="font-size:16px;font-weight:600;">Monthly Tenant Growth</div>
                    <div style="font-size:13px;color:var(--text-muted);">New businesses registered per month</div>
                </div>
                <div class="badge-pos badge-accent">Last 6 Months</div>
            </div>
            <div class="chart-container" style="height:260px;">
                <canvas id="monthlyTenantsChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Subscription Status Breakdown -->
    <div class="col-lg-4">
        <div class="pos-card h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <div style="font-size:16px;font-weight:600;">Subscription Health</div>
                    <div style="font-size:13px;color:var(--text-muted);">Account status breakdown</div>
                </div>
            </div>
            <div class="chart-container" style="height:220px;display:flex;align-items:center;justify-content:center;">
                <canvas id="subscriptionPieChart"></canvas>
            </div>
            <div class="d-flex justify-content-around mt-3 text-center" style="font-size:12px;">
                <div><i class="bi bi-circle-fill me-1" style="color:#10b981;font-size:8px;"></i> Active: @Model.ActiveTenants</div>
                <div><i class="bi bi-circle-fill me-1" style="color:#f59e0b;font-size:8px;"></i> Expired: @Model.ExpiredTenants</div>
                <div><i class="bi bi-circle-fill me-1" style="color:#ef4444;font-size:8px;"></i> Blocked: @Model.BlockedTenants</div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Tenants Table -->
<div class="pos-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <div style="font-size:16px;font-weight:600;">Recently Onboarded Businesses</div>
            <div style="font-size:13px;color:var(--text-muted);">Latest tenant accounts and their current license status</div>
        </div>
        <a href="/SuperAdmin" class="btn-pos btn-ghost" style="font-size:12px;padding:6px 14px;">
            View All Tenants <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div style="overflow-x:auto;">
        <table class="pos-table">
            <thead>
                <tr>
                    <th>Business Name</th>
                    <th>Branch</th>
                    <th>Admin Credentials</th>
                    <th>Registered</th>
                    <th>Subscription Expiry</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tenant in Model.RecentTenants)
                {
                    var isExpired = !tenant.IsBlocked && tenant.SubscriptionEndDate.Date < DateTime.UtcNow.Date;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:36px;height:36px;background:var(--accent);border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:700;color:white;font-size:15px;flex-shrink:0;">
                                    @tenant.Name.Substring(0,1).ToUpper()
                                </div>
                                <div class="fw-600">@tenant.Name</div>
                            </div>
                        </td>
                        <td>@(string.IsNullOrEmpty(tenant.BranchName) ? "Main Branch" : tenant.BranchName)</td>
                        <td>
                            <div style="font-size:12px;">
                                <span class="text-muted">ID:</span> <strong style="color:var(--accent);">@tenant.AdminEmail</strong>
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="text-muted" style="font-size:12px;">PW:</span>
                                <span id="tpw-masked-@tenant.Id" style="font-family:monospace;font-size:12px;letter-spacing:1px;">&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;</span>
                                <span id="tpw-plain-@tenant.Id" class="d-none" style="font-family:monospace;font-size:12px;color:var(--accent);font-weight:600;">@tenant.AdminPasswordPlain</span>
                                <button type="button" class="btn-pos btn-ghost" style="padding:1px 5px;font-size:11px;" onclick="toggleTenantPassword('@tenant.Id')">
                                    <i id="teye-@tenant.Id" class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                        </td>
                        <td style="font-size:12px;color:var(--text-muted);">@tenant.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="fw-600 @(isExpired ? "text-danger" : "text-success")" style="font-size:13px;">
                                @tenant.SubscriptionEndDate.ToString("dd MMM yyyy")
                            </span>
                        </td>
                        <td>
                            @if (tenant.IsBlocked)
                            {
                                <span class="badge-pos badge-danger">Blocked</span>
                            }
                            else if (isExpired)
                            {
                                <span class="badge-pos badge-warning">Expired</span>
                            }
                            else
                            {
                                <span class="badge-pos badge-success">Active</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <a href="/SuperAdmin/EditTenant/@tenant.Id" class="btn-pos btn-ghost" style="padding:6px 12px;font-size:12px;">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.RecentTenants.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;color:var(--text-muted);padding:30px;">
                            No tenants registered yet. Click <strong>+ New Tenant</strong> to onboard your first customer!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const textColor = isDark ? '#94a3b8' : '#64748b';
    const gridColor = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';

    Chart.defaults.color = textColor;
    Chart.defaults.borderColor = gridColor;
    Chart.defaults.font.family = 'Inter';

    // Monthly Growth Bar Chart
    new Chart(document.getElementById('monthlyTenantsChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(monthlyLabelsJson),
            datasets: [{
                label: 'New Tenants',
                data: @Html.Raw(monthlyCountsJson),
                backgroundColor: '#6366f1',
                borderRadius: 6,
                barThickness: 28
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                x: { grid: { color: gridColor } },
                y: { 
                    grid: { color: gridColor },
                    ticks: { stepSize: 1, precision: 0 }
                }
            }
        }
    });

    // Subscription Status Doughnut Chart
    new Chart(document.getElementById('subscriptionPieChart'), {
        type: 'doughnut',
        data: {
            labels: ['Active', 'Expired', 'Blocked'],
            datasets: [{
                data: [@Model.ActiveTenants, @Model.ExpiredTenants, @Model.BlockedTenants],
                backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: { display: false }
            }
        }
    });

    function toggleTenantPassword(id) {
        const masked = document.getElementById('tpw-masked-' + id);
        const plain = document.getElementById('tpw-plain-' + id);
        const icon = document.getElementById('teye-' + id);
        if (masked.classList.contains('d-none')) {
            masked.classList.remove('d-none');
            plain.classList.add('d-none');
            icon.className = 'bi bi-eye-fill';
        } else {
            masked.classList.add('d-none');
            plain.classList.remove('d-none');
            icon.className = 'bi bi-eye-slash-fill';
        }
    }
</script>
}