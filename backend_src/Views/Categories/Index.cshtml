@model IEnumerable<EnterprisePOS.Models.Entities.Category>
@{
    ViewBag.Title = "Manage Categories";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0" style="color: var(--text-primary); font-weight:700;">Product Categories</h1>
            <p class="text-muted mb-0">Create and manage your own custom menu categories.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="background-color: var(--accent); border-color: var(--accent);">
            <i class="bi bi-plus-lg me-2"></i>Create Category
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0" role="alert" style="background-color: #10b98122; color: #10b981; border-radius: 8px;">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0" role="alert" style="background-color: #ef444422; color: #ef4444; border-radius: 8px;">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="pos-card" style="overflow-x:auto;">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-folder-fill text-muted" style="font-size: 48px;"></i>
                <h5 class="mt-3" style="color: var(--text-primary);">No Categories Found</h5>
                <p class="text-muted">Create a category to begin adding products to your menu.</p>
            </div>
        }
        else
        {
            <table class="pos-table">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 100px;">Menu Order</th>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var catList = Model.ToList(); }
                    @for (int i = 0; i < catList.Count; i++)
                    {
                        var cat = catList[i];
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-secondary rounded-pill px-2 py-1 me-1">@(i + 1)</span>
                                    <form asp-action="MoveUp" asp-route-id="@cat.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary p-0 px-1" title="Move Up" @(i == 0 ? "disabled" : "")>
                                            <i class="bi bi-chevron-up"></i>
                                        </button>
                                    </form>
                                    <form asp-action="MoveDown" asp-route-id="@cat.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary p-0 px-1" title="Move Down" @(i == catList.Count - 1 ? "disabled" : "")>
                                            <i class="bi bi-chevron-down"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                            <td class="fw-semibold">
                                @if (!string.IsNullOrEmpty(cat.ColorHex))
                                {
                                    <span class="d-inline-block rounded-circle me-2" style="width: 12px; height: 12px; background-color: @cat.ColorHex;"></span>
                                }
                                @cat.Name
                            </td>
                            <td>@cat.Description</td>
                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="badge-pos badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge-pos badge-danger">Inactive</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-flex justify-content-end gap-8">
                                    <a asp-action="Edit" asp-route-id="@cat.Id" class="btn-pos btn-ghost" style="padding:6px 10px;" title="Edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this category?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-pos btn-danger" style="padding:6px 10px;" title="Delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
