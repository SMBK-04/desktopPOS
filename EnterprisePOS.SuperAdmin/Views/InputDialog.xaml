<Window x:Class="EnterprisePOS.SuperAdmin.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="180" Width="350" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#1e293b">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtPrompt" Text="Enter value:" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="txtResponse" FontSize="14" Margin="0,0,0,15"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
