<UserControl x:Class="EnterprisePOS.SuperAdmin.Views.TenantProvisioningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <StackPanel MaxWidth="400" HorizontalAlignment="Left">
            <TextBlock Text="Provision New Tenant" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBox x:Name="txtCompany" materialDesign:HintAssist.Hint="Company Name" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
            <TextBox x:Name="txtEmail" materialDesign:HintAssist.Hint="Admin Email" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
            <TextBox x:Name="txtBranch" materialDesign:HintAssist.Hint="Branch Name" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15" />
            <PasswordBox x:Name="txtPassword" materialDesign:HintAssist.Hint="Admin Password" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,25" />
            
            <Button Content="Provision Tenant" Click="BtnProvision_Click" />
            
            <TextBlock x:Name="txtResult" Margin="0,20,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryHueLightBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
