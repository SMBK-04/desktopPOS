<UserControl x:Class="EnterprisePOS.SuperAdmin.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Platform Dashboard" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <WrapPanel Grid.Row="1">
            <materialDesign:Card Width="300" Height="150" Margin="10" Background="{DynamicResource PrimaryHueDarkBrush}" Foreground="{DynamicResource PrimaryHueDarkForegroundBrush}">
                <StackPanel Margin="20">
                    <TextBlock Text="Monthly Recurring Revenue" FontSize="16" Opacity="0.8"/>
                    <TextBlock x:Name="txtMrr" Text="$0.00" FontSize="36" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </materialDesign:Card>
            
            <materialDesign:Card Width="300" Height="150" Margin="10" Background="{DynamicResource SecondaryHueDarkBrush}" Foreground="{DynamicResource SecondaryHueDarkForegroundBrush}">
                <StackPanel Margin="20">
                    <TextBlock Text="Active Tenants" FontSize="16" Opacity="0.8"/>
                    <TextBlock x:Name="txtTenants" Text="0" FontSize="36" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </WrapPanel>
    </Grid>
</UserControl>
