<UserControl x:Class="EnterprisePOS.SuperAdmin.Views.SubscriptionBillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Subscription &amp; Billing Manager" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Refresh" Margin="20,0,0,0" Click="BtnRefresh_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgTenants" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" />
                <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" />
                <DataGridTextColumn Header="Password" Binding="{Binding PasswordHash}" />
                <DataGridTemplateColumn Header="Payment Due">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Subscriptions[0].IsPaymentDue}" IsEnabled="False" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Mark Due" Margin="0,0,5,0" Click="BtnMarkDue_Click" CommandParameter="{Binding Id}" />
                                <Button Content="Mark Paid" Margin="0,0,5,0" Click="BtnMarkPaid_Click" CommandParameter="{Binding Id}" />
                                <Button Content="Change Pwd" Margin="0,0,5,0" Click="BtnChangePassword_Click" CommandParameter="{Binding Id}" Background="#f59e0b" Foreground="White" />
                                <Button Content="Delete" Click="BtnDelete_Click" CommandParameter="{Binding Id}" Background="#ef4444" Foreground="White" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
