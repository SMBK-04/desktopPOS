<UserControl x:Class="EnterprisePOS.SuperAdmin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Platform Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="Monthly Subscription Rate" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Rs " VerticalAlignment="Center" FontSize="16"/>
                <TextBox x:Name="txtMonthlyRate" Width="150" FontSize="16" Text="1000"/>
            </StackPanel>

            <TextBlock Text="Default POS Admin Email" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDefaultEmail" Width="300" FontSize="14" Text="admin@local.pos" Margin="0,0,0,20" IsReadOnly="True"/>

            <TextBlock Text="Default POS Admin Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDefaultPassword" Width="300" FontSize="14" Text="1234" Margin="0,0,0,20" IsReadOnly="True"/>

            <TextBlock Text="API Server Status" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtApiStatus" Text="Checking..." Foreground="Green" FontSize="14" Margin="0,0,0,20"/>

            <Button Content="Save Settings" Width="150" HorizontalAlignment="Left" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
