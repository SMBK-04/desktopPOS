<UserControl x:Class="EnterprisePOS.ClientPOS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BgPrimary}"
             TextElement.Foreground="{DynamicResource TextPrimary}"
             Loaded="UserControl_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Printer Settings" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="30" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Configure Receipt Printers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <TextBlock Text="Enter the exact Windows Printer Name. To print silently, the names must match exactly what is installed on this PC." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBox x:Name="txtCustomerPrinter" materialDesign:HintAssist.Hint="Customer Receipt Printer Name" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="16" Margin="0,0,0,20"/>
                <TextBox x:Name="txtKitchenPrinter" materialDesign:HintAssist.Hint="Kitchen Printer Name" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="16" Margin="0,0,0,30"/>

                <Button Content="Save Settings" Width="150" HorizontalAlignment="Left" Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0" Height="40" Click="BtnSave_Click"/>
                
                <TextBlock x:Name="txtStatus" Foreground="{DynamicResource SuccessColor}" FontWeight="SemiBold" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
