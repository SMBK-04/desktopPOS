<UserControl x:Class="EnterprisePOS.ClientPOS.Views.UsersManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BgPrimary}"
             TextElement.Foreground="{DynamicResource TextPrimary}"
             Loaded="UserControl_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Users &amp; Roles" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Add User Form -->
            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,20,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Add New User" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox x:Name="txtUsernamePrefix" materialDesign:HintAssist.Hint="Username" Width="150" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="16"/>
                        <TextBlock x:Name="txtDomain" Text="@restaurant.com" FontSize="16" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                    </StackPanel>
                    
                    <PasswordBox x:Name="txtPassword" materialDesign:HintAssist.Hint="Password" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" FontSize="16" Margin="0,0,0,20"/>
                    
                    <ComboBox x:Name="cmbRole" materialDesign:HintAssist.Hint="Role" Style="{StaticResource MaterialDesignFloatingHintComboBox}" FontSize="16" Margin="0,0,0,30">
                        <ComboBoxItem Content="Cashier" IsSelected="True"/>
                        <ComboBoxItem Content="Manager"/>
                    </ComboBox>
                    
                    <Button Content="Create User" Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0" Height="40" Click="BtnAddUser_Click"/>
                </StackPanel>
            </Border>

            <!-- Users List -->
            <Border Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="20">
                <DataGrid x:Name="dgUsers" AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Email / Username" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
