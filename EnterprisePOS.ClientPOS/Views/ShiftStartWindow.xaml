<Window x:Class="EnterprisePOS.ClientPOS.Views.ShiftStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Title="Start Shift" Height="300" Width="350" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Start Your Shift" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBox x:Name="txtFloat" materialDesign:HintAssist.Hint="Opening Float ($)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" HorizontalAlignment="Center" Width="200" FontSize="20" HorizontalContentAlignment="Center" Text="0.00" />
            <TextBlock x:Name="txtError" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <Button Content="START SHIFT" Margin="0,30,0,0" Width="200" Click="BtnStart_Click" />
        </StackPanel>
    </Grid>
</Window>
