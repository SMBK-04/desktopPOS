<Window x:Class="EnterprisePOS.ClientPOS.Views.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Title="End Shift (Z-Report)" Height="450" Width="400" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Shift Closeout" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <Grid Margin="0,10">
                <TextBlock Text="Opening Float:" FontSize="16"/>
                <TextBlock x:Name="txtOpeningFloat" Text="$0.00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,10">
                <TextBlock Text="Cash Sales:" FontSize="16"/>
                <TextBlock x:Name="txtCashSales" Text="$0.00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,10,0,20">
                <TextBlock Text="Expected Drawer:" FontSize="16" Foreground="{DynamicResource PrimaryHueLightBrush}"/>
                <TextBlock x:Name="txtExpectedCash" Text="$0.00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource PrimaryHueLightBrush}"/>
            </Grid>

            <TextBox x:Name="txtActualCash" materialDesign:HintAssist.Hint="Actual Cash In Drawer ($)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" HorizontalAlignment="Stretch" FontSize="20" HorizontalContentAlignment="Center" Margin="0,0,0,10" TextChanged="TxtActualCash_TextChanged" />
            
            <Grid Margin="0,10,0,20">
                <TextBlock Text="Discrepancy:" FontSize="16"/>
                <TextBlock x:Name="txtDiscrepancy" Text="$0.00" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock x:Name="txtError" Foreground="Red" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="CANCEL" Margin="0,0,10,0" Width="120" Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnCancel_Click" />
                <Button Content="CONFIRM END SHIFT" Width="180" Click="BtnConfirm_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
