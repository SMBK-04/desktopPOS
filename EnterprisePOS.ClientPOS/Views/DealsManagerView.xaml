<UserControl x:Class="EnterprisePOS.ClientPOS.Views.DealsManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BgPrimary}"
             TextElement.Foreground="{DynamicResource TextPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="28,20">
            <StackPanel>
                <TextBlock Text="Deals Manager" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Create special deals with custom pricing for your customers" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Deal Form Panel -->
            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="txtFormTitle" Text="New Deal" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                        <!-- Deal Name -->
                        <TextBlock Text="Deal Name" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource BgHover}" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                            <TextBox x:Name="txtDealName" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}" materialDesign:HintAssist.Hint="e.g. Combo Meal, Family Bundle..."/>
                        </Border>

                        <!-- Deal Price -->
                        <TextBlock Text="Deal Price (Rs)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource BgHover}" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                            <TextBox x:Name="txtDealPrice" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}" materialDesign:HintAssist.Hint="Custom price for this deal"/>
                        </Border>

                        <!-- Products in Deal -->
                        <TextBlock Text="Select Products Included in Deal" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource BgHover}" CornerRadius="8" Padding="8" Margin="0,0,0,20" MaxHeight="280">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="icProductsChecklist">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,4" Margin="0,2" CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BgPrimary}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="{DynamicResource TextPrimary}" FontSize="13" VerticalAlignment="Center">
                                                        <CheckBox.Resources>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}"/>
                                                        </CheckBox.Resources>
                                                    </CheckBox>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Qty:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBox Text="{Binding Quantity}" Width="30" TextAlignment="Center" Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Buttons -->
                        <Button x:Name="btnSaveDeal" Content="Save Deal" Click="BtnSaveDeal_Click" Background="{DynamicResource AccentColor}" Foreground="White" BorderThickness="0" Height="44" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button x:Name="btnCancelDeal" Content="Cancel Edit" Click="BtnCancelDeal_Click" Background="{DynamicResource BgHover}" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Height="38" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: Deals List -->
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="All Deals" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icDeals">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,16" Width="220">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Deal Icon Header -->
                                        <Border Grid.Row="0" Background="{DynamicResource AccentSoft}" CornerRadius="12,12,0,0">
                                            <materialDesign:PackIcon Kind="TagMultiple" Width="48" Height="48" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Deal Info -->
                                        <StackPanel Grid.Row="1" Margin="14">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Price, StringFormat=Rs {0:N2}}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit" Click="BtnEditDeal_Click" Background="Transparent" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" Foreground="{DynamicResource AccentColor}" FontSize="11" Height="30" Padding="12,0" Margin="0,0,8,0"/>
                                                <Button Content="Delete" Click="BtnDeleteDeal_Click" Background="Transparent" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" Foreground="{DynamicResource DangerColor}" FontSize="11" Height="30" Padding="12,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
