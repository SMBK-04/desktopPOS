<UserControl x:Class="EnterprisePOS.ClientPOS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BgPrimary}"
             TextElement.Foreground="{DynamicResource TextPrimary}"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="txtDate" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Stat Cards Row -->
            <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,28">

                <!-- Today's Sales -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Margin="0,0,16,0" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#1e1b4b" CornerRadius="8" Width="40" Height="40">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Foreground="{DynamicResource AccentColor}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="txtOverallSales" Text="Rs 0.00" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Text="Today's Revenue" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Grid>
                </Border>

                <!-- Total Orders Today -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Margin="0,0,16,0" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="#052e16" CornerRadius="8" Width="40" Height="40" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="ShoppingOutline" Foreground="{DynamicResource SuccessColor}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" x:Name="txtTotalOrders" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Text="Orders Today" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Grid>
                </Border>

                <!-- Total Products -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Margin="0,0,16,0" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="#1c1917" CornerRadius="8" Width="40" Height="40" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="FoodVariant" Foreground="{DynamicResource WarningColor}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" x:Name="txtTotalProducts" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Text="Products" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Grid>
                </Border>

                <!-- Total Users -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Margin="0" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="#1e1b4b" CornerRadius="8" Width="40" Height="40" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="AccountMultiple" Foreground="{DynamicResource InfoColor}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" x:Name="txtTotalUsers" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Text="Staff Users" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Recent Sales Header -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="Recent Orders" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Last 10 transactions" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Recent Sales Table -->
            <Border Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Padding="0">
                <DataGrid x:Name="dgRecentSales"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#0affffff"
                          Foreground="{DynamicResource TextPrimary}"
                          ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="200"/>
                        <DataGridTextColumn Header="Order Type" Binding="{Binding OrderType}" Width="120"/>
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="120"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=Rs \{0:N2\}}" Width="140"/>
                        <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding Timestamp, StringFormat=\{0:dd MMM yyyy hh:mm tt\}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

