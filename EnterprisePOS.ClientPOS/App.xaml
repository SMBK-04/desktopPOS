<Application x:Class="EnterprisePOS.ClientPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Indigo" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- Custom UI Variables (Dark Mode Default) matching CSS -->
            <SolidColorBrush x:Key="BgPrimary" Color="#0f172a" />
            <SolidColorBrush x:Key="BgSecondary" Color="#1e293b" />
            <SolidColorBrush x:Key="BgCard" Color="#1e293b" />
            <SolidColorBrush x:Key="BgSidebar" Color="#0f172a" />
            <SolidColorBrush x:Key="BgHover" Color="#334155" />
            <SolidColorBrush x:Key="BorderColor" Color="#334155" />
            <SolidColorBrush x:Key="TextPrimary" Color="#f1f5f9" />
            <SolidColorBrush x:Key="TextSecondary" Color="#94a3b8" />
            <SolidColorBrush x:Key="TextMuted" Color="#64748b" />
            <SolidColorBrush x:Key="AccentColor" Color="#6366f1" />
            <SolidColorBrush x:Key="AccentHover" Color="#4f46e5" />
            <SolidColorBrush x:Key="AccentSoft" Color="#2A2A5E" />
            <SolidColorBrush x:Key="SuccessColor" Color="#10b981" />
            <SolidColorBrush x:Key="WarningColor" Color="#f59e0b" />
            <SolidColorBrush x:Key="DangerColor" Color="#ef4444" />
            <SolidColorBrush x:Key="InfoColor" Color="#3b82f6" />
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
